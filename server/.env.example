# -------------------------------------------------------------
# ResQnet Server Environment Configuration
# -------------------------------------------------------------
PORT=5000

# Google Gemini AI API Key (Google AI Studio / GCP)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model identifier (Defaults to gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# Comma-separated list of staff emails with commander privileges
STAFF_EMAILS=staff@resqnet.com,admin@resqnet.com

# Optional: Firebase Admin Service Account Key JSON (as a single-line string)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}
